{
  "name": "@tia/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm prisma:generate && nest build",
    "dev": "pnpm prisma:generate && nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "typecheck": "pnpm prisma:generate && tsc --noEmit",
    "test": "pnpm prisma:generate && NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:e2e": "tsx test/prepare-test-database.ts && DATABASE_URL=$TEST_DATABASE_URL prisma migrate deploy --config prisma7.config.ts && DATABASE_URL=$TEST_DATABASE_URL prisma db seed --config prisma7.config.ts && DATABASE_URL=$TEST_DATABASE_URL NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:validate": "prisma validate --config prisma7.config.ts",
    "db:migrate:dev": "prisma migrate dev --config prisma7.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:seed": "prisma db seed --config prisma7.config.ts",
    "openapi:generate": "pnpm build && node dist/generate-openapi.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.9",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "^26.6.6",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "29.7.0",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "29.4.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
