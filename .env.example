# Local/demo database. Use different values outside local development.
POSTGRES_USER=tia
POSTGRES_PASSWORD=local_tia_password
POSTGRES_DB=tia

# The only host port published by either Compose profile.
APP_PORT=8080

# Internal service configuration.
PROVIDER_API_KEY=local_provider_key
PROVIDER_BASE_URL=http://provider-mock:3001

# Authentication secrets. Replace before any non-local deployment.
JWT_ACCESS_SECRET=local_access_secret_replace_me_32_chars
JWT_REFRESH_SECRET=local_refresh_secret_replace_me_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Browser-facing settings.
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
